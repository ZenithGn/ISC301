# =====================================================================
# KHÔNG commit: bí mật (.env.local), dependency, build, file tạm, file hệ điều hành.
# VẪN commit: .env.example (file mẫu, không chứa bí mật thật).
# =====================================================================

# ---------- Biến môi trường / BÍ MẬT ----------
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
# Bỏ qua mọi file .env* còn lại (kể cả .env.backup, .env.old)...
.env*
# ...NHƯNG luôn giữ file mẫu để người khác biết cần biến gì:
!.env.example

# ---------- Dependencies ----------
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---------- Next.js / build ----------
.next/
out/
build/
dist/
next-env.d.ts
*.tsbuildinfo

# ---------- Kiểm thử & output tạm ----------
coverage
playwright-report
test-results
.tmp-*/
/.tmp-payos-test/
/.tmp-webhook/
/.tmp-cloud/

# ---------- Log ----------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------- Chứng chỉ / khoá ----------
*.pem
*.key
*.p12

# ---------- Vercel / Supabase CLI ----------
.vercel
supabase/.temp/
supabase/.branches/

# ---------- Hệ điều hành / trình soạn thảo ----------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~