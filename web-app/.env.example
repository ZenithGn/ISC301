# =====================================================================
# Hương Quê – biến môi trường mẫu
# Sao chép file này thành `.env.local` rồi điền giá trị thật.
# KHÔNG commit `.env.local` lên git.
# =====================================================================

# ---------- Ứng dụng ----------
# production: https://huongque.vn
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------- Supabase ----------
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# CHỈ dùng ở server (webhook PayOS, cron, RPC chỉ cấp cho service_role).
# TUYỆT ĐỐI không đặt trong biến NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ---------- PayOS (thay thế VNPay) ----------
# Lấy 3 khóa tại https://my.payos.vn > Kênh thanh toán > Thông tin tích hợp
PAYOS_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PAYOS_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
PAYOS_CHECKSUM_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Chỉ đổi khi cần trỏ sang môi trường khác; mặc định https://api-merchant.payos.vn
# PAYOS_API_URL=https://api-merchant.payos.vn

# ---------- Email giao dịch (Resend) ----------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="Hương Quê <don-hang@huongque.vn>"

# ---------- Cron (Vercel gửi header Authorization: Bearer <CRON_SECRET>) ----------
CRON_SECRET=chuoi-ngau-nhien-dai

# ---------- Google Analytics 4 ----------
# Chỉ gửi 2 sự kiện: view_item và purchase
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ---------- Cloudinary (upload ảnh sản phẩm + avatar) ----------
# MỘT dòng duy nhất, copy nguyên từ Cloudinary Dashboard > "API environment variable":
#   cloudinary://<api_key>:<api_secret>@<cloud_name>
# Nếu THIẾU biến này, app tự fallback sang Supabase Storage (bucket product-images).
CLOUDINARY_URL=cloudinary://123456789012345:xxxxxxxxxxxxxxxxxxxxxxxxxxxx@your-cloud-name

# ---------- Tùy chọn khác ----------
# (Không còn cookie phiên tự ký: quyền hạn chỉ dựa trên session Supabase + bảng profiles)
